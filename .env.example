# Concord — variáveis de exemplo (copiar para apps/api/.env)
NODE_ENV=development
API_PORT=3000
API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://concord:concord@localhost:5432/concord?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
OAUTH_SUCCESS_REDIRECT=concord://auth/callback
BOOTSTRAP_ADMIN_EMAIL=

STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=concord
S3_SECRET_KEY=concordsecret
S3_BUCKET=concord-attachments
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000

TURN_URLS=turn:localhost:3478
TURN_SECRET=concord-turn-secret
STUN_URLS=stun:localhost:3478
INVITE_DEFAULT_TTL_DAYS=7
