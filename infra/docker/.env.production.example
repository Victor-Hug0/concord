# Copie para .env.production e preencha (não commitar secrets):
#   cp infra/docker/.env.production.example infra/docker/.env.production

# Domínio público da API (DNS A/AAAA apontando para a VPS).
# Também usa files.<DOMAIN> para MinIO e TURN em <DOMAIN>:3478
# Ex.: DOMAIN=concord.televei.dev  →  API https://concord.televei.dev  |  files https://files.concord.televei.dev
DOMAIN=concord.televei.dev

# Postgres (só rede interna do Compose)
POSTGRES_USER=concord
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=concord

# MinIO
MINIO_ROOT_USER=concord
MINIO_ROOT_PASSWORD=troque-esta-senha-minio
S3_BUCKET=concord-attachments
S3_REGION=us-east-1

# JWT (gere strings longas e aleatórias)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS do desktop Electron
CORS_ORIGIN=app://.

# SMTP (envio do código de verificação no cadastro)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Concord <concord@televei.dev>
EMAIL_VERIFICATION_TTL_MINUTES=15

# TURN (mesmo secret do coturn)
TURN_SECRET=troque-este-turn-secret
STUN_URLS=stun:stun.l.google.com:19302

INVITE_DEFAULT_TTL_DAYS=7

# Primeira subida: 1 para seed (admin + invite). Depois volte para 0.
RUN_SEED=1
