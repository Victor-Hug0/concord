# Concord API — multi-stage production image (monorepo pnpm)
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile --filter @concord/api...

COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
RUN pnpm --filter @concord/shared build \
  && pnpm --filter @concord/api exec prisma generate \
  && pnpm --filter @concord/api build

FROM base AS runner
ARG DEPLOY_SHA=local
ENV NODE_ENV=production
ENV DEPLOY_SHA=${DEPLOY_SHA}
WORKDIR /app

COPY --from=build /app /app
COPY infra/docker/api-entrypoint.sh /api-entrypoint.sh
RUN chmod +x /api-entrypoint.sh

WORKDIR /app/apps/api
EXPOSE 3000
ENTRYPOINT ["/api-entrypoint.sh"]
