# Concord — nginx atrás do proxy existente (:80/:443)
# Copie ANTES do certbot (só HTTP). O certbot adiciona SSL sozinho.
#
#   sudo cp infra/docker/nginx-concord.conf.example /etc/nginx/sites-available/concord
#   sudo ln -sf /etc/nginx/sites-available/concord /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d concord.televei.dev -d files.concord.televei.dev
#
# Requer API em 127.0.0.1:3000 e MinIO em 127.0.0.1:9000 (docker-compose.prod.yml).

# --- API + WebSocket ---
server {
    listen 80;
    listen [::]:80;
    server_name concord.televei.dev;

    client_max_body_size 512m;

    location /ws {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }
}

# --- MinIO (anexos) ---
server {
    listen 80;
    listen [::]:80;
    server_name files.concord.televei.dev;

    client_max_body_size 512m;

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }
}
